{
  /*** Sim GLIM ROS config ***
  GLIM subscribes to sensor_msgs/PointCloud2. In this sim pipeline,
  /livox/lidar is Livox CustomMsg for FAST-LIO compatibility, so GLIM must use
  the adapter's PointCloud2 topic instead.
  */
  "glim_ros": {
    "enable_local_mapping": true,
    "enable_global_mapping": true,
    "keep_raw_points": false,
    "imu_time_offset": 0.0,
    "points_time_offset": 0.0,
    "acc_scale": 1.0,
    "imu_frame_id": "livox_frame",
    "lidar_frame_id": "livox_frame",
    "base_frame_id": "glim_base",
    "odom_frame_id": "glim_odom",
    "map_frame_id": "glim_map",
    "publish_imu2lidar": false,
    "tf_time_offset": 1e-6,
    "extension_modules": [
      "libmemory_monitor.so",
      "libstandard_viewer.so",
      "librviz_viewer.so"
    ],
    "imu_topic": "/livox/imu",
    "points_topic": "/livox/lidar_pc2_accumulated",
    "image_topic": "/image",
    "imu_qos": {
      "profile": "sensor_data",
      "depth": 1000
    },
    "points_qos": {
      "profile": "sensor_data"
    },
    "image_qos": {
      "profile": "sensor_data"
    }
  }
}
