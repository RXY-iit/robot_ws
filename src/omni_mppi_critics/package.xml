<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>omni_mppi_critics</name>
  <version>0.1.0</version>
  <description>
    Custom nav2 MPPI critic plugins for 3-wheel steer+drive omnidirectional robots.
    SteeringChangeCritic penalises trajectories with large wheel steering angle changes.
  </description>
  <maintainer email="dat-g-pxt-ra@roboken.iit.tsukuba.ac.jp">ruan-x</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>nav2_mppi_controller</depend>
  <depend>pluginlib</depend>

  <build_depend>xtensor</build_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_mppi_controller plugin="${prefix}/critics_plugin.xml"/>
  </export>
</package>
