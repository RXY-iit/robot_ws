#!/usr/bin/python3
"""Stable ROS executable name for both copied and symlink installations."""
from pathlib import Path
import runpy
import sys

if __name__ == "__main__":
    script_dir = Path(__file__).resolve().parent
    sys.path.insert(0, str(script_dir))
    runpy.run_path(str(script_dir / "gicp_localizer_node.py"), run_name="__main__")
